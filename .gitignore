# Build directories
/build/
/build-*/
/cmake-build-*/
/out/

# CMake user files
/CMakeUserPresets.json
/compile_commands.json

# IDE files
/.vs/
/.vscode/
/.idea/
*.user
*.suo
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

