# Build directories
/build/
/build-*/
/cmake-build-*/
/out/

# CMake user files
/CMakeUserPresets.json
/compile_commands.json

# IDE files
/.vs/
/.vscode/
/.idea/
*.user
*.suo
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# Downloaded third-party dependencies
/third_party/vcpkg/
/third_party/vcpkg_installed/
/third_party/downloads/
/third_party/buildtrees/
/third_party/packages/
/third_party/vcpkg-cache/

# Program outputs and temporary files
/output/*
!/output/.gitkeep
/tmp/

# Large image data
/data/images/*
!/data/images/.gitkeep
*.tif
*.tiff
*.img

# Logs and local files
*.log
*.tmp
Thumbs.db
desktop.ini
.DS_Store

