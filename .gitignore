/third_party/opencv/
/third_party/libtiff/

# Program outputs and temporary files
/output/*
!/output/.gitkeep
/tmp/

# Large image data
/data/images/*
!/data/images/.gitkeep
*.tif
*.tiff
*.img

# Logs and local files
*.log
*.tmp
Thumbs.db
desktop.ini
.DS_Store
